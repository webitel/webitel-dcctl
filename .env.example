# Environment of webitel-dcctl serve. The configuration itself is /etc/webitel/dcctl/config.yaml.
# OpenTelemetry exporter of webitel-go-kit, see https://pkg.go.dev/github.com/webitel/webitel-go-kit/infra/otel/sdk#section-readme
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
#OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#OTEL_LOGS_EXPORTER=otlpgrpc
#OTEL_TRACES_EXPORTER=otlpgrpc
#OTEL_METRICS_EXPORTER=otlpgrpc

# Prometheus exporter, serves /metrics. Used with OTEL_METRICS_EXPORTER=prometheus.
#OTEL_EXPORTER_PROMETHEUS_HOST=127.0.0.1
#OTEL_EXPORTER_PROMETHEUS_PORT=9464
