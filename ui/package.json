{
  "name": "webitel-dcctl-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@webitel/api-services": "~26.10.8",
    "@webitel/styleguide": "~26.10.3",
    "@webitel/ui-sdk": "~26.10.7",
    "axios": "1.21.1",
    "clipboard-copy": "4.0.1",
    "pinia": "3.0.4",
    "vue": "3.5.46",
    "vue-i18n": "11.4.23",
    "vue-router": "4.6.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@faker-js/faker": "10.6.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "api-spec-converter": "2.12.0",
    "jsdom": "31.0.1",
    "msw": "2.15.0",
    "openapi-format": "1.34.0",
    "orval": "8.49.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "vite --mode backend",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome ci ./src ./*.ts",
    "format": "biome check --write ./src ./*.ts",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "npm run gen:api:convert && npm run gen:api:format && orval && npm run gen:api:cleanup",
    "gen:api:convert": "mkdir -p .gen && api-spec-converter --from=swagger_2 --to=openapi_3 --syntax=yaml ../api/dcctl.swagger.json > .gen/openapi.yaml",
    "gen:api:format": "openapi-format .gen/openapi.yaml -o .gen/openapi.formatted.yaml",
    "gen:api:cleanup": "rm -rf .gen"
  }
}
